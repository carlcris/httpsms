# The service account must belong to the Firebase project configured in the Android APK.
FIREBASE_PROJECT_ID=your-project-id
# Store the service account JSON in a Functions-scoped Netlify environment variable.
# For local development you can instead set GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_CREDENTIALS={"project_id":"your-project-id","client_email":"...","private_key":"..."}
GATEWAY_COLLECTION_PREFIX=sms_gateway
GATEWAY_MESSAGE_TTL_SECONDS=300
# Interval between wake-up attempts while a message has not been claimed by the phone.
GATEWAY_DISPATCH_INTERVAL_SECONDS=60
GATEWAY_SWEEP_BATCH_SIZE=5
# URL of YOUR published fork, containing the source for the deployed gateway.
SOURCE_CODE_URL=

# Emulator-only development (never set on production):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GATEWAY_MOCK_PUSH=true
